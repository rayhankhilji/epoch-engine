# ─────────────────────────────────────────────────────────────
# Epoch — BYOK (Bring Your Own Keys)
#
# Every agent in Epoch thinks via a real LLM. You choose which.
# Set one or more of these. Agents are assigned providers by the
# scenario file, so a single world can contain Claude agents,
# GPT agents and Grok agents reasoning against each other.
#
# Copy to .env — .env is gitignored and never committed.
# ─────────────────────────────────────────────────────────────

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# xAI (Grok) — https://console.x.ai
XAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq (fast open-weight inference) — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (one key, many models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama (fully local, no key needed) — https://ollama.com
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ─────────────────────────────────────────────────────────────
# World data — all live providers Epoch uses are free and keyless
# (Open-Meteo, Nominatim, REST Countries, Frankfurter, Stooq,
# CoinGecko, Hacker News, GDELT, Hipolabs). Nothing to set.
#
# Nominatim asks for a contact string in the User-Agent header.
# ─────────────────────────────────────────────────────────────
EPOCH_CONTACT_EMAIL=

# Server
PORT=8787
EPOCH_DB_PATH=./data/epoch.db
